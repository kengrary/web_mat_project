<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      JFR 解析器（独立可执行 JAR）。

      协议: java -jar jfr-parser.jar <input.jfr> <output.duckdb>
      - 基于 jdk.jfr.consumer.RecordingFile 单次流式遍历（JDK 14+ 内置，无第三方依赖）
      - 堆栈指纹聚合：前 5 个业务帧 MD5 → stack_traces 字典表 + hotspots 聚合表
      - 产物是独立 DuckDB 文件（duckdb_jdbc shaded 打包），Python 侧 read_only 直连

      与 query-service（OSGi/Tycho）不同，这是普通 maven-jar + shade，
      不依赖 MAT 发行版，可独立分发。
    -->
    <groupId>com.jvmind.jfr</groupId>
    <artifactId>jfr-parser</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <duckdb.jdbc.version>1.2.1</duckdb.jdbc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>${duckdb.jdbc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>jfr-parser</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.jvmind.jfr.JfrParser</mainClass>
                                </transformer>
                                <!-- duckdb_jdbc 是多 release jar；shade 需保留 META-INF/versions -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
